# Clones and metadata live in ./data (created at runtime).

# Public URL behind the reverse proxy. Used for the Google redirect URI.
# PUBLIC_ORIGIN=https://md-viewer.example.com

# Signs session cookies. Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Google OAuth web client. Authorized redirect URI: {PUBLIC_ORIGIN}/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts allowed to sign in.
# ALLOWED_EMAILS=you@gmail.com
